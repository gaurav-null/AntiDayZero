[Unit]
Description=eBPF-iforest-ids Syscall Anomaly Detector
Documentation=https://github.com/crazy-idea/ebpf-iforest-ids
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/ebpf-iforest-ids
Environment="PATH=/opt/ebpf-iforest-ids/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONUNBUFFERED=1"

# Command to run the daemon
ExecStart=/opt/ebpf-iforest-ids/.venv/bin/python -m daemon.main detect
ExecReload=/bin/kill -HUP $MAINPID

# Restart policy
Restart=on-failure
RestartSec=5

# Security hardening (optional - relax if needed)
# CapabilityBoundingSet=CAP_BPF CAP_SYS_ADMIN CAP_PERFMON CAP_SYS_RESOURCE
# NoNewPrivileges=true
# ProtectSystem=strict
# ProtectHome=true
# ReadWritePaths=/sys/fs/bpf /var/lib/ebpf-iforest /var/log/ebpf-iforest

# Resource limits
LimitNOFILE=65536

# Standard output and error
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ebpf-iforest-ids

[Install]
WantedBy=multi-user.target